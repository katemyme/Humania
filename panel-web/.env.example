# Opcional. El panel arranca sin este archivo usando el proyecto de demostración
# (los valores por defecto están en src/supabaseClient.js).
#
# Solo necesitas esto si quieres apuntar a TU propio proyecto de Supabase:
# copia este archivo como .env.local y rellena los dos valores.
# Están en Supabase → Project Settings → API.
#
# Nunca pongas aquí la clave service_role.

VITE_SUPABASE_URL=https://<tu-proyecto>.supabase.co
VITE_SUPABASE_ANON_KEY=<tu-anon-key>
